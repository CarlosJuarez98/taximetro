{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/assets/**", "/logo.png", "/*.(svg|png|jpg|jpeg|gif|webp)"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api-get",
      "urls": ["/api/tarifa", "/api/auth/me"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 40,
        "maxAge": "1d",
        "timeout": "3s"
      }
    }
  ]
}
